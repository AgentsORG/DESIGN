    when_not: ["decorative misuse outside brand patterns"]
    variants: [default]
    tokens:
      default:
        backgroundColor: "{tokens.color.canvas-night}"
        textColor: "{tokens.color.on-dark}"
        typography: "{tokens.typography.body-md}"
        rounded: "{tokens.radius.lg}"
        padding: "32px"
  card-feature-dark:
