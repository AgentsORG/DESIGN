  spacing:
    unit: 8
    xxs: "4px"
    xs: "8px"
    sm: "12px"
    md: "17px"
    lg: "24px"
    xl: "32px"
    xxl: "48px"
    section: "80px"
  radius:
    none: "0px"
    xs: "5px"
    sm: "8px"
    md: "11px"
    lg: "18px"
    pill: "9999px"
    full: "9999px"

locked:
  - tokens.color.primary
  - tokens.color.canvas
  - tokens.color.ink

components:
  button:
    description: "Button family from DESIGN.md component tokens"
    when: ["primary and secondary actions", "CTAs documented in rationale.components"]
    when_not: ["inventing off-system button chrome", "more than one filled primary per view unless brand allows"]
    variants:
      - button-primary
      - button-primary-focus
      - button-primary-active
      - button-secondary-pill
      - button-dark-utility
      - button-pearl-capsule
      - button-store-hero
      - button-icon-circular
    states: [active, default, focus]
    tokens:
      button-primary:
        backgroundColor: "{tokens.color.primary}"
        textColor: "{tokens.color.on-primary}"
        typography: "{tokens.typography.body}"
        rounded: "{tokens.radius.pill}"
        padding: "11px 22px"
      button-primary-focus:
        backgroundColor: "{tokens.color.primary}"
        textColor: "{tokens.color.on-primary}"
        rounded: "{tokens.radius.pill}"
      button-primary-active:
        backgroundColor: "{tokens.color.primary}"
        textColor: "{tokens.color.on-primary}"
        rounded: "{tokens.radius.pill}"
      button-secondary-pill:
        backgroundColor: "{tokens.color.canvas}"
        textColor: "{tokens.color.primary}"
        typography: "{tokens.typography.body}"
        rounded: "{tokens.radius.pill}"
        padding: "11px 22px"
      button-dark-utility:
        backgroundColor: "{tokens.color.ink}"
        textColor: "{tokens.color.on-dark}"
        typography: "{tokens.typography.button-utility}"
        rounded: "{tokens.radius.sm}"
        padding: "8px 15px"
      button-pearl-capsule:
        backgroundColor: "{tokens.color.surface-pearl}"
        textColor: "{tokens.color.ink-muted-80}"
        typography: "{tokens.typography.caption}"
        rounded: "{tokens.radius.md}"
        padding: "8px 14px"
      button-store-hero:
        backgroundColor: "{tokens.color.primary}"
        textColor: "{tokens.color.on-primary}"
        typography: "{tokens.typography.button-large}"
        rounded: "{tokens.radius.pill}"
        padding: "14px 28px"
      button-icon-circular:
        backgroundColor: "{tokens.color.surface-chip-translucent}"
        textColor: "{tokens.color.ink}"
        rounded: "{tokens.radius.full}"
        size: "44px"
  text-link:
    description: "DESIGN.md component token group"
    when: ["as documented in rationale.components and getdesign analysis"]
    when_not: ["decorative misuse outside brand patterns"]
    variants: [default]
    tokens:
      default:
        backgroundColor: transparent
        textColor: "{tokens.color.primary}"
        typography: "{tokens.typography.body}"
  text-link-on-dark:
    description: "DESIGN.md component token group"
    when: ["as documented in rationale.components and getdesign analysis"]
    when_not: ["decorative misuse outside brand patterns"]
    variants: [default]
    tokens:
