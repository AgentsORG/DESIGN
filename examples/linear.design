    unit: 8
    xxs: "4px"
    xs: "8px"
    sm: "12px"
    md: "16px"
    lg: "24px"
    xl: "32px"
    xxl: "48px"
    section: "96px"
  radius:
    xs: "4px"
    sm: "6px"
    md: "8px"
    lg: "12px"
    xl: "16px"
    xxl: "24px"
    pill: "9999px"
    full: "9999px"
  elevation:
    note: "See rationale.elevation for brand depth model; add concrete shadow tokens as they stabilize."

locked:
  - tokens.color.primary
  - tokens.color.canvas
  - tokens.color.ink

components:
  button:
    description: "Button family from DESIGN.md component tokens"
    when: ["primary and secondary actions", "CTAs documented in rationale.components"]
    when_not: ["inventing off-system button chrome", "more than one filled primary per view unless brand allows"]
    variants:
      - button-primary
      - button-primary-pressed
      - button-primary-hover
      - button-secondary
      - button-tertiary
      - button-inverse
    states: [default, hover, pressed]
    tokens:
      button-primary:
        backgroundColor: "{tokens.color.primary}"
        textColor: "{tokens.color.on-primary}"
        typography: "{tokens.typography.button}"
        rounded: "{tokens.radius.md}"
        padding: "8px 14px"
      button-primary-pressed:
        backgroundColor: "{tokens.color.primary-focus}"
        textColor: "{tokens.color.on-primary}"
        typography: "{tokens.typography.button}"
        rounded: "{tokens.radius.md}"
      button-primary-hover:
